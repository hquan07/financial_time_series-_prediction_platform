# Copy to .env for local use. Supply real values only in the untracked copy.
# Phase 2 Compose will bind 127.0.0.1:19000/19001 for MinIO and
# 127.0.0.1:15432 for PostgreSQL; recheck host ports before starting it.
FRED_API_KEY=
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=financial-time-series
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=financial_time_series
POSTGRES_USER=
POSTGRES_PASSWORD=
